# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# SQLite (default, no server needed). For PostgreSQL install psycopg and use:
# DATABASE_URL=postgresql+psycopg://docuconvert:password@localhost:5432/docuconvert
DATABASE_URL=sqlite:///./docuconvert.db

# Local storage root (shared by inputs, outputs and temporary work dirs)
STORAGE_DIR=../storage

MAX_UPLOAD_MB=200
MAX_FILES_PER_JOB=15
RESULT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15
CONVERSION_TIMEOUT_SECONDS=180
# Page previews are rendered separately from the downloaded result.
PREVIEW_DPI=96
PREVIEW_MAX_WIDTH=1400
PREVIEW_MAX_PAGES=60
ALLOW_ANONYMOUS=true
RATE_LIMIT_PER_MINUTE=60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional external tools. Leave empty for auto-detection.
# Word is the reference DOCX -> PDF renderer on Windows; LibreOffice is the fallback
# and is required for PPTX tools. This server never downloads fonts.
# WORD_PATH=C:/Program Files/Microsoft Office/root/Office16/WINWORD.EXE
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
WORD_PATH=
LIBREOFFICE_PATH=
TESSERACT_CMD=
