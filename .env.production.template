# Production Environment Configuration
# Copy to .env.production and fill in all values
# NEVER commit this file with real secrets!

# ============================================
# DOMAIN & SSL (Required)
# ============================================
DOMAIN=HXconvert.com
EMAIL=admin@HXconvert.com

# ============================================
# DATABASE (PostgreSQL - Required for production)
# ============================================
POSTGRES_DB=docuconvert
POSTGRES_USER=docuconvert
POSTGRES_PASSWORD=generate-strong-password-here

# ============================================
# BACKEND SECRETS (Required)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-strong-random-secret-key-here

# ============================================
# CORS (Required - your frontend domain)
# ============================================
CORS_ORIGINS=https://HXconvert.com,https://www.HXconvert.com

# ============================================
# FRONTEND
# ============================================
# Leave EMPTY for same-origin relative requests through nginx (recommended —
# no CORS at all, guest cookie stays the most robust). Only set an absolute
# URL if the API is served from a different domain.
NEXT_PUBLIC_API_URL=

# ============================================
# OPTIONAL: Feature Flags
# ============================================
# Set to true to allow anonymous conversions (no login required).
# true = public conversion platform (rate-limited); false = login enforced.
ALLOW_ANONYMOUS=true

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# File upload limits
MAX_UPLOAD_MB=200
MAX_BATCH_SIZE_MB=1024
MAX_FILES_PER_JOB=15

# 0 = auto (CPU cores - 1, max 6). Tune down on small VPS instances.
CONVERSION_WORKERS=0

# Job timeout — long batches up to 300s; never cancels jobs early.
CONVERSION_TIMEOUT_SECONDS=300

# Result retention
RESULT_TTL_HOURS=24

# ============================================
# OPTIONAL: External Services
# ============================================
# Redis (if using external Redis instead of docker-compose)
# REDIS_URL=redis://redis:6379/0

# S3-compatible storage for files (optional)
# S3_ENDPOINT=https://s3.yourprovider.com
# S3_BUCKET=docuconvert
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx