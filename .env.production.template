# Production Environment Configuration
# Copy to .env.production and fill in all values
# NEVER commit this file with real secrets!

# ============================================
# DOMAIN & SSL (Required)
# ============================================
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com

# ============================================
# DATABASE (PostgreSQL - Required for production)
# ============================================
POSTGRES_DB=docuconvert
POSTGRES_USER=docuconvert
POSTGRES_PASSWORD=generate-strong-password-here

# ============================================
# BACKEND SECRETS (Required)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-strong-random-secret-key-here

# ============================================
# CORS (Required - your frontend domain)
# ============================================
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# FRONTEND
# ============================================
# Origin only (no /api/v1); the client appends /api/v1 itself.
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ============================================
# OPTIONAL: Feature Flags
# ============================================
# Set to true to allow anonymous conversions (no login required)
ALLOW_ANONYMOUS=false

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# File upload limits
MAX_UPLOAD_MB=25
MAX_FILES_PER_JOB=10

# Result retention
RESULT_TTL_HOURS=24

# ============================================
# OPTIONAL: External Services
# ============================================
# Redis (if using external Redis instead of docker-compose)
# REDIS_URL=redis://redis:6379/0

# S3-compatible storage for files (optional)
# S3_ENDPOINT=https://s3.yourprovider.com
# S3_BUCKET=docuconvert
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx