# Base URL of the FastAPI backend (no trailing slash).
# Use 127.0.0.1 rather than localhost on Windows to avoid IPv6 resolution issues.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Vercel production -----------------------------------------------------
# Same-origin proxy (recommended without a custom domain): leave
# NEXT_PUBLIC_API_URL unset and set BACKEND_URL in Vercel so next.config.ts
# rewrites /api/* to Railway. BACKEND_URL is a build-time server variable.
# BACKEND_URL=https://your-backend.up.railway.app
#
# Direct API (best for large uploads and custom domains): set the public URL
# at build time instead, and configure COOKIE_SAMESITE=none on the backend if
# the browser origin is on a different site.
# NEXT_PUBLIC_API_URL=https://api.example.com
